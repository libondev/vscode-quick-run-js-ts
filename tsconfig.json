{
  "compilerOptions": {
    "target": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["vscode", "node"]
  },
  "include": ["src/**/*", "playground/**/*"]
}
