{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "eslint", "import", "vitest", "promise", "unicorn", "typescript"],
  "env": {
    "node": true,
    "es2020": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "curly": "error"
  }
}
